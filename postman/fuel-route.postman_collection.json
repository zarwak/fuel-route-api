    {
      "name": "6. GET with query string",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/route?start=Denver, CO&finish=Phoenix, AZ",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ],
          "query": [
            {
              "key": "start",
              "value": "Denver, CO"
            },
            {
              "key": "finish",
              "value": "Phoenix, AZ"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
