{
  "info": {
    "name": "Fuel Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the server with `python manage.py runserver`, then run these requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "1. Chicago to Dallas (place names)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Main demo: ~971 miles, 4 fuel stops. First call uses 3 routing-service calls."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"has route, stops and cost\", () => { pm.expect(d.map.features[0].geometry.type).to.eql(\"LineString\"); pm.expect(d).to.have.property(\"total_fuel_cost\"); });",
              "pm.test(\"max 3 routing-service calls\", () => pm.expect(d.meta.routing_service_calls).to.be.at.most(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Same trip again (cached)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Dallas, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Run right after #1: meta.routing_service_calls is 0 and it returns in about 0.1 s."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"has route, stops and cost\", () => { pm.expect(d.map.features[0].geometry.type).to.eql(\"LineString\"); pm.expect(d).to.have.property(\"total_fuel_cost\"); });",
              "pm.test(\"max 3 routing-service calls\", () => pm.expect(d.meta.routing_service_calls).to.be.at.most(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Coordinates only (1 routing call)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/route",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": {\n    \"lat\": 41.8781,\n    \"lon\": -87.6298\n  },\n  \"finish\": \"32.7767,-96.7970\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Coordinates skip geocoding, so only 1 call to the routing service."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"has route, stops and cost\", () => { pm.expect(d.map.features[0].geometry.type).to.eql(\"LineString\"); pm.expect(d).to.have.property(\"total_fuel_cost\"); });",
              "pm.test(\"max 3 routing-service calls\", () => pm.expect(d.meta.routing_service_calls).to.be.at.most(3));"
            ]
          }
        }
      ]
    },
