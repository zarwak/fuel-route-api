          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": {\n    \"lat\": 51.5,\n    \"lon\": -0.12\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400\", () => pm.response.to.have.status(400));",
              "pm.test(\"clear error message\", () => pm.expect(pm.response.json().error).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
